# Copy to backend/.env, fill only the integrations you use, then restart the API.
# Never commit backend/.env or platform access credentials.
BRAVE_SEARCH_API_KEY=

# Bearer credential for producers calling /api/v1/growth/collect or /orders.
GROWTH_COLLECTOR_TOKEN=

# Authorized incremental signal service. GET returns signals and next_cursor.
GROWTH_SIGNALS_URL=
GROWTH_SIGNALS_TOKEN=
GROWTH_SIGNALS_SOURCE=collector

# Authorized advertising adapter implementing docs/GROWTH.md.
GROWTH_ADS_BASE_URL=
GROWTH_ADS_TOKEN=
# CNY cents; execution also checks each reviewed proposal's own cap.
GROWTH_MAX_BUDGET_MINOR=1000000
GROWTH_MAX_RECHARGE_MINOR=1000000
